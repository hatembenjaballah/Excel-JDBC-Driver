/**
 * Implémentation JDBC de {@link Connection} pour un fichier Excel.
 * <p>
 * Une connexion est associée à un seul fichier Excel. Ce fichier est ouvert en
 * mode lecture/écriture via Apache POI. Les feuilles du classeur sont
 * considérées comme des tables de la base de données.
 * </p>
 * <p>
 * La connexion délègue l'exécution des requêtes SQL à un {@link SQLExecutor}
 * et la manipulation des feuilles à un {@link TableManager}.
 * </p>
 */
public class ExcelConnection implements Connection {

    // Chemin du fichier Excel (ex: "C:/data.xlsx")
    private final String filePath;

    // Objet Workbook POI représentant le fichier Excel ouvert
    private Workbook workbook;

    // Propriétés de connexion (peuvent contenir des informations supplémentaires)
    private final Properties info;

    // Indicateur de fermeture
    private boolean closed = false;

    // Gestionnaire de tables (feuilles) : lecture, écriture, création, suppression
    private final TableManager tableManager;

    // Moteur d'exécution SQL : parse et exécute les requêtes sur les données en mémoire
    private final SQLExecutor sqlExecutor;

    /**
     * Constructeur appelé par le Driver lors du {@link Driver#connect(String, Properties)}.
     * 
     * @param filePath chemin absolu ou relatif vers le fichier .xlsx ou .xls
     * @param info     propriétés de connexion (non utilisées intensivement ici)
     * @throws SQLException si le fichier est introuvable, illisible ou d'un format non supporté
     */
    public ExcelConnection(String filePath, Properties info) throws SQLException {
        this.filePath = filePath;
        this.info = info;

        try {
            FileInputStream fis = new FileInputStream(filePath);
            // Détection du format en fonction de l'extension
            if (filePath.endsWith(".xlsx")) {
                workbook = new XSSFWorkbook(fis);   // Format Office Open XML (2007+)
            } else if (filePath.endsWith(".xls")) {
                workbook = new HSSFWorkbook(fis);   // Ancien format binaire (97-2003)
            } else {
                throw new SQLException("Format de fichier non supporté : " + filePath);
            }
        } catch (IOException e) {
            throw new SQLException("Impossible d'ouvrir le fichier Excel : " + filePath, e);
        }

        // Initialiser les modules internes
        tableManager = new TableManager(workbook);
        sqlExecutor = new SQLExecutor(tableManager, filePath);
    }
    public String getFilePath() {
		return this.filePath;
	}
    /**
     * Fournit l'exécuteur SQL pour que les Statements puissent déléguer les requêtes.
     */
    public SQLExecutor getSqlExecutor() {
        return sqlExecutor;
    }

    /**
     * Fournit le gestionnaire de tables pour les métadonnées ou opérations directes.
     */
    public TableManager getTableManager() {
        return tableManager;
    }

    /**
     * Crée un Statement standard (non préparé) lié à cette connexion.
     */
    @Override
    public Statement createStatement() throws SQLException {
    	close();
        return new ExcelStatement(this);
    }

    /**
     * Crée un PreparedStatement à partir d'une requête SQL avec paramètres.
     */
    @Override
    public PreparedStatement prepareStatement(String sql) throws SQLException {
    	close();
        return new ExcelPreparedStatement(this, sql);
    }

    /**
     * Retourne les métadonnées de la "base de données" (c'est-à-dire du fichier Excel).
     */
    @Override
    public DatabaseMetaData getMetaData() throws SQLException {
        return new ExcelDatabaseMetaData(this);
    }

    /**
     * Ferme la connexion et libère les ressources associées au fichier.
     * La sauvegarde éventuelle est déjà faite par le SQLExecutor après chaque mise à jour.
     */
    @Override
    public void close() throws SQLException {
        try {
            if (workbook != null) {
                workbook.close();
            }
        } catch (IOException e) {
            throw new SQLException("Erreur lors de la fermeture du fichier Excel", e);
        }
        closed = true;
    }

